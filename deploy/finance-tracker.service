# systemd service for running the finance tracker on a Raspberry Pi (or any Linux box).
# Install:  sudo cp deploy/finance-tracker.service /etc/systemd/system/
#           sudo sed -i "s/YOUR_USER/$USER/g" /etc/systemd/system/finance-tracker.service
#           sudo systemctl enable --now finance-tracker
# Logs:     journalctl -u finance-tracker -f

[Unit]
Description=Finance Tracker web app
Wants=network-online.target
After=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/Finance-Tracker
ExecStart=/home/YOUR_USER/Finance-Tracker/.venv/bin/python main.py --web --port 8000
Restart=on-failure
RestartSec=5

# Hardening: the app can only write to its own data folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/YOUR_USER/.local/share/finance-tracker
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
